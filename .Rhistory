raw_alpha = alpha_res,
sumscore = NA,
data = "based on observed items \ncovariance from full test"))
info_alpha2$data <- factor(info_alpha2$data,
levels = c("based on observed items \ncovariance from full test",
"imputed start & stop test",
"full test"),
labels = c("unimputed start & stop",
"imputed start & stop",
"full"))

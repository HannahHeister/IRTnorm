geom_line(aes(thetastar_round,value, color = model), linewidth =1.05, data = compare_agg_long[compare_agg_long$model != "full_observed",]) +
geom_line(aes(thetastar_round,value, color = model),linetype= "dashed", linewidth =1.05, data = compare_agg_long[compare_agg_long$model == "full_observed",]) +
geom_point(aes(thetastar_round,value, color = model), size = 2, data = compare_agg_long) +
xlab("normed latent trait") +  scale_color_manual(values = my_cols[5:1])+
theme_bw() + ylab("RMSE") +
theme(text = element_text(size=12,family = "serif"),
# legend.position = "bottom",
axis.line = element_line(color='black'),
plot.background = element_blank(),
panel.grid.minor = element_blank(),
panel.grid.major = element_blank(),
#axis.text.x = element_text(angle = 45, hjust = 1),
legend.box = "vertical")
ggsave(file = "Adaptive.png", units = "cm", width = 13, height = 10, dpi = 300)
ggsave(file = "Adaptive.png", units = "cm", width = 17, height = 10, dpi = 300)
ggsave(file = "Adaptive.png", units = "cm", width = 17, height = 8, dpi = 300)

psych::alpha(data_random_test[[3]][,1:68], warnings=FALSE)$total$raw_alpha),
age = rep("(5,20]",2),
data = c("full","imputed start & stop"),
sumscore = c(sd(data_random$sumscore),
sd(data_random_test[[3]]$sumscore)))
# delete items that are answered with no variance
alpha_res <- NULL
age <- NULL
for(group in sort(unique(data_random$age_group))){
# Step 1: keep only items with at least one observed value
data_int <- data_random[data_random$age_group == group,1:68]
cor_mat <- cov(data_int , use = "pairwise.complete.obs")
data_i <- data_random_test[[2]][data_random_test[[2]]$age_group == group,1:68 ]
# uniquely for each individual
for(j in 1:nrow(data_int)){
cor_mat_temp <- cor_mat[!is.na(data_i[j,]),!is.na(data_i[j,])]
if(any(colSums(cor_mat_temp == 0) ==ncol(cor_mat_temp))){
cor_mat_temp <- cor_mat_temp[which(!colSums(cor_mat_temp == 0) ==ncol(cor_mat_temp)), which(!colSums(cor_mat_temp == 0) ==ncol(cor_mat_temp))]
}
alpha_res <- c(alpha_res, psych::alpha(cor_mat_temp, n.obs = nrow(data_int), warnings=FALSE)$total$raw_alpha)
}
age <- c(age, rep(group, nrow(data_int)))
}
# combin all information

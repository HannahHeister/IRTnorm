Sim_data <- function (rep = 25, seed = 1234, alpha = alpha_data, beta = beta_data, grid = T){
set.seed(seed)
nitem <- length(alpha)
# age <- runif(nperson, 5,20)
#normedability <- rnorm(nperson,0,1)
if(grid == TRUE){
person <-  expand.grid(age = seq(5,20,2),
normedability = qnorm(c(0.01, 0.05, 0.1,0.25,0.4,0.5,0.6,0.75,0.9,0.95,0.99)),
IDperson = 1:rep)
}
if(grid == FALSE){
person <-  data.frame(age = runif(rep, 5,20),
normedability = rnorm(rep,0,1),
IDperson = 1:rep)
}
age <- person$age
nperson <- nrow(person)
normedability <- person$normedability
age_center <- (age - mean(age))
age_poly <-  model.matrix( ~ poly(age, 3, raw = T), data = data.frame(age = age_center))
mean_age <- age_poly[,1:4] %*% coef_mu
sd_age <- exp(age_poly[,1:3] %*% coef_sigma)
ability <- normedability*sd_age  + mean_age
psolve <- matrix(0, nperson, nitem)
for (i in 1:nperson){
for(j in 1:nitem){
psolve[i, j] <- exp(alpha[j] * (ability[i] - beta[j]))/
(1 + exp(alpha[j] * (ability[i]  - beta[j])))
}
}
R <- (matrix(runif(nitem * nperson), nperson, nitem) < psolve) * 1
data <- cbind(R, age, normedability, ability, sd_age, mean_age, 1:(length(ability)))
colnames(data) <- c(paste0("item",1:nitem), "age", "true_thetastar",
"true_theta", "sd_age","mean_age", "person_ID")
return(as.data.frame(data))
}

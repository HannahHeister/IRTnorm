load("G:/Meine Ablage/2_Adaptiv_testing/Rcode/OSF/fit_2PLnorm_verbal_thinking.Rdata")
alpha_data <- (as.numeric(summary(fit,pars="alpha")$summary[,1]))
beta_data <- (as.numeric(summary(fit,pars="beta")$summary[,1]))
coef_mu <- (as.numeric(summary(fit,pars="p1_theta")$summary[,1]))
coef_sigma <- (as.numeric(summary(fit,pars="p2_theta")$summary[,1]))
rm(fit)
#Simulate new observations
# INPUT:
# seed: numerical value for reproducibility
# alpha: vector indicating the item discrimination parameters of the test
#        by default the item parameters from your model are used
# beta: vector indicating the item difficulty parameters of the test
#        by default the item parameters from your model are used
# person_character: data.frame indicating the person characteristics of the individuals to simulate.
#       with the variables age normedability and IDperson
# an example to evaluate on a grid is with gird_eval
grid_eval <-  expand.grid(age = seq(5,20,2),
normedability = qnorm(c(0.01, 0.05, 0.1,0.25,0.4,0.5,0.6,0.75,0.9,0.95,0.99)),
IDperson = 1:25)
# an example to sample random individuals is with random_eval
set.seed(1234)
rep <- 1000
random_eval <-  data.frame(age = runif(rep, 5,20),
normedability = rnorm(rep,0,1),
IDperson = 1:rep)
Sim_data <- function (seed = 1234, alpha = alpha_data, beta = beta_data, person_character = NULL){
set.seed(seed)
nitem <- length(alpha)
age <- person_character$age
nperson <- nrow(person_character)
normedability <- person_character$normedability
age_center <- (age - mean(age))
age_poly <-  model.matrix( ~ poly(age, 3, raw = T), data = data.frame(age = age_center))
mean_age <- age_poly[,1:4] %*% coef_mu
sd_age <- exp(age_poly[,1:3] %*% coef_sigma)
ability <- normedability*sd_age  + mean_age
psolve <- matrix(0, nperson, nitem)
for (i in 1:nperson){
for(j in 1:nitem){
psolve[i, j] <- exp(alpha[j] * (ability[i] - beta[j]))/
(1 + exp(alpha[j] * (ability[i]  - beta[j])))
}
}
R <- (matrix(runif(nitem * nperson), nperson, nitem) < psolve) * 1
data <- cbind(R, age, normedability, ability, sd_age, mean_age, 1:(length(ability)))
colnames(data) <- c(paste0("item",1:nitem), "age", "true_thetastar",
"true_theta", "sd_age","mean_age", "person_ID")
return(as.data.frame(data))
}
# replaces all items after three consecutive errors as with the value of the users choice
# mat: matrix of the item responses, to be order of the columns has to be the same as the order in the test (order of difficulty)
# replace_choice: value with which those the items after three consecutive errors should be replaced.
recode_after_three_zeros <- function(mat, replace_choice) {
t(apply(mat, 1, function(row) {
n <- length(row)
pos <- NA
for (j in 1:(n-2)) {
if (row[j]==0 && row[j+1]==0 && row[j+2]==0) {
pos <- j+2  # end of first run
break
}
}
if (!is.na(pos) && pos < n) {
row[(pos+1):n] <- replace_choice
}
row
}))
}
# This function is specifically written implement the starting and stopping rule
# of the IDS-2 for the domain verbal thinking.
# When you want to use your own data, you have to adjust the function to suite
# your starting and stopping rules.
transform_data_block <- function(data_full){
# NA
data_NA <- data_full
data_NA[,paste0("item",1:34)] <- recode_after_three_zeros(as.matrix(data_NA[,paste0("item",1:34)]),  replace_choice = NA)
data_NA[,paste0("item",35:68)] <- recode_after_three_zeros(as.matrix(data_NA[,paste0("item",35:68)]),  replace_choice = NA)
data_NA[data_full$age>= 9, paste0("item",1:4)] <- NA
data_NA[data_full$age >= 13, paste0("item",5:9)] <- NA
data_NA[data_full$age >= 9, paste0("item",35:44)] <- NA
# imputed
data_imp <- data_full
data_imp[,paste0("item",1:34)] <- recode_after_three_zeros(as.matrix(data_imp[,paste0("item",1:34)]),  replace_choice = 0)
data_imp[,paste0("item",35:68)] <- recode_after_three_zeros(as.matrix(data_imp[,paste0("item",35:68)]),  replace_choice = 0)
data_imp[data_full$age >= 9, paste0("item",1:4)] <- 1
data_imp[data_full$age >= 13, paste0("item",5:9)] <- 1
data_imp[data_full$age >= 9, paste0("item",35:44)] <- 1
no_adaptive_info <- list(data_full,
data_NA,
data_imp)
return(no_adaptive_info)
}

ylab("values") + xlab("age in years") +
theme_bw() +
theme(text = element_text(size=12,family = "serif"),
axis.line = element_line(color='black'),
plot.background = element_blank(),
panel.grid.minor = element_blank(),
panel.grid.major = element_blank(),
legend.box = "vertical")

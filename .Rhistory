library(devtools)
library(roxygen2)
setwd("D:/Documents/GitHub/IRTnorm/")
roxygen2::roxygenise()
devtools::load_all()
library(IRTnorm)
load("G:/Meine Ablage/1_IRTnorm/HOmodel_testfunction/HOdata.rda")
knitr::opts_chunk$set(echo = TRUE)
infoHO <- estimate_norming_model(irt_model = "HO1PLnorm-C",
raw_data = HOdata,
age_variable = "age",
item_variables = 1:90,
itemD = rep(1:3, each = 30),
age_model = "poly",
poly_mean = 3,
poly_sd = 2,
seed = 1234,
iter_warmup = 500,
iter_sampling =500,
extract_stan_object = TRUE)

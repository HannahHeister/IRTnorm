nitem = c(data_amount_item_all$step))
all_info_fixeditemperperson_all <- cbind(rbind(all_info_fixeditemperperson, all_info_fixeditemperperson2),
stopcrit = c(rep(c("like with \nstart & stop rule"), each = nrow(all_info_fixeditemperperson)),
rep(c( "fixed: 32"), each = nrow(all_info_fixeditemperperson2))))
compare<- all_info_fixeditemperperson_all %>% group_by(thetastar_round, model,age,stopcrit) %>% summarise(RMSE = rmse(thetastar_true, thetastar_est),
BIAS = bias(thetastar_true, thetastar_est),
RMSE_theta = rmse(theta_true, theta_est),
BIAS_theta = bias(theta_true, theta_est))
compare_agg <- all_info_fixeditemperperson_all %>% group_by(thetastar_round, model,stopcrit) %>% summarise(RMSE = rmse(thetastar_true, thetastar_est),
BIAS = bias(thetastar_true, thetastar_est),
RMSE_theta = rmse(theta_true, theta_est))
compare_agg_long <- compare_agg %>%
pivot_longer(cols = c(RMSE, BIAS),
names_to = "measurement",
values_to = "value")
compare_agg_long$measurement <- factor( compare_agg_long$measurement,
levels = c("RMSE","BIAS"))
compare_agg_long$model[ compare_agg_long$model == "missing_values"] <- "start & stop rule"
compare_agg_long$model[ compare_agg_long$model == "adaptive"] <- "adaptive itempool 68"
compare_agg_long$model <- factor(compare_agg_long$model,
levels = c("start & stop rule",
"imputed_values",
"full_observed",
"adaptive itempool 68",
"adaptive itempool 200",
"adaptive itempool 500"),
labels = c("start&stop test",
"imputed_values",
"full test",
"adaptive item pool 68",
"adaptive item pool 200",
"adaptive item pool 500"))
compare_agg_long$stopcrit[compare_agg_long$stopcrit == "like with \nstart & stop rule"] <- "like in start&stop test"
compare_agg_long$stopcrit[ compare_agg_long$model == "full test"] <- "fixed: 32"
my_cols <- viridis(6, option = "plasma")[5:1]
ggplot(compare_agg_long[compare_agg_long$model != "imputed_values",]) +
geom_line(aes(thetastar_round,value, color = model, linetype = stopcrit)) +
geom_point(aes(thetastar_round,value, color = model, shape = stopcrit)) +
facet_wrap(~measurement, ncol = 1, scale = "free_y") +
xlab("normed latent trait") +  scale_color_manual(values = my_cols)+
geom_hline(
data = subset(compare_agg_long, measurement == "BIAS"),
aes(yintercept = 0),
linetype = "dashed") +
theme_bw() + labs(color = "test \nadministration",
shape = "number of \nobserved items",
linetype = "number of \nobserved items") +

prep_data <- function(data, int_variables){
nitem <- length(int_variables)
nperson <- nrow(data)
int_test <- data.frame(answer = as.vector(as.matrix(data[,int_variables])),
item = rep(1:nitem, each = nperson),
person = rep(1:nperson, nitem))
int_observed <- int_test[- which(is.na(int_test$answer)),]
age <- data$age_years
age_center <- (age - mean(age))
age_poly <- as.matrix((model.matrix(~ poly(age,3, raw = TRUE), data = data.frame(age = age_center))))
normingdata_IRT <- list(I = nitem,
J = nperson,
N = nrow(int_observed),
S = ncol(age_poly),
W = ncol(age_poly) -1 ,
ii = int_observed$item,
jj = int_observed$person,
y = int_observed$answer,
age = age_poly,
age2 = age_poly[,1:3],
fixed_beta =1,
free_beta = 2:nitem,
fixed_alpha =1,
free_alpha = 2:nitem)
return(normingdata_IRT)
}
